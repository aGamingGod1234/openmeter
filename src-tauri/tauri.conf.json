{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenMeter",
  "mainBinaryName": "openmeter-tray",
  "version": "0.5.0",
  "identifier": "com.agaminggod.openmeter",
  "build": {
    "beforeDevCommand": "npm --prefix .. run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix .. run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "OpenMeter",
        "dragDropEnabled": false,
        "width": 380,
        "height": 600,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/aGamingGod1234/openmeter/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZEOENENjIyMDVDODM0MDcKUldRSE5NZ0ZJdGFNYlJCUEgra2N1a1hpNEk5L0lKdTNnbTdzTHRGOE5jRGQzSU1ES2ZRd3dvTCsK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "OpenMeter contributors",
    "copyright": "© 2026 OpenMeter contributors (MIT)",
    "shortDescription": "AI usage limits in your system tray",
    "longDescription": "OpenMeter shows how much of your session and weekly limits each AI tool has left, directly from the Windows system tray.",
    "resources": {
      "target/release/openmeter.exe": "openmeter.exe",
      "windows/path.ps1": "path.ps1"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
